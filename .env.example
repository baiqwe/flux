# ==============================================
# FluxKlein Environment Variables
# ==============================================

# Supabase Configuration
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Replicate API (Required for Flux Image Generation)
# Get your API token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Creem Payment Configuration
# Get your credentials from https://creem.io
CREEM_WEBHOOK_SECRET=
CREEM_API_KEY=
CREEM_API_URL=https://test-api.creem.io/v1

# Site URLs (Update for production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BASE_URL=localhost:3000
CREEM_SUCCESS_URL=http://localhost:3000/en/create

# Optional: OpenAI/OpenRouter for translations
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ==============================================
# Production Configuration (uncomment for prod)
# ==============================================
# CREEM_API_URL=https://api.creem.io/v1
# NEXT_PUBLIC_SITE_URL=https://fluxklein.ai
# CREEM_SUCCESS_URL=https://fluxklein.ai/en/create
